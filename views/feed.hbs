<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}}</title>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="phone-screen">
    <div class="feed-content">
      {{#if data.shareholder}}
        <video
          class="feed-video"
          src="{{data.shareholder.videoKey}}"
          autoplay
          loop
          muted
          playsinline
        ></video>

        <div class="feed-overlay">
          <div class="feed-bottom-left">
            <h2 class="feed-name">{{data.shareholder.title}}</h2>
            <p class="feed-description">{{data.shareholder.description}}</p>
          </div>

          <div class="feed-right-panel">
            <div class="feed-stat">
              <span class="feed-stat-value">{{data.shareholder.ownershipShare}}%</span>
              <span class="feed-stat-label">Доля</span>
            </div>
            <div class="feed-stat">
              <span class="feed-stat-value">{{data.shareholder.sharesCount}}</span>
              <span class="feed-stat-label">Акций</span>
            </div>
            <div class="feed-stat">
              <span class="feed-stat-value">❤ {{data.likesCount}}</span>
            </div>
            <a href="/dividends/feed/{{data.shareholder.id}}?next=true" class="feed-next-btn">↓</a>
          </div>
        </div>
      {{else}}
        <p class="empty-state">Акционер не найден</p>
      {{/if}}
    </div>

    {{> tabbar active="feed" }}
  </div>
</body>
</html>