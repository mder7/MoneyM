<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Акционер №{{data.id}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  {{> header }}
  <main class="page">
    <a href="/dividends" class="back-link">← Назад к списку</a>
    {{#if data.shareholder}}
      <div class="detail-card">
        <div class="card-badge">№{{data.id}}</div>
        <h1>{{data.shareholder.title}}</h1>
        <div class="card-stats">
          <div class="stat">
            <span class="stat-value">{{data.shareholder.ownershipShare}}%</span>
            <span class="stat-label">Доля владения</span>
          </div>
          <div class="stat">
            <span class="stat-value">{{data.shareholder.sharesCount}}</span>
            <span class="stat-label">Акций</span>
          </div>
        </div>
        <p class="page-date">Дата: {{data.current_date}}</p>
      </div>
    {{else}}
      <p class="empty-state">Акционер не найден</p>
    {{/if}}
  </main>
</body>
</html>