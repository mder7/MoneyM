<div class="card-grid">
  {{#each data.shareholders}}
    <a href="/dividends/shareholder/{{this.id}}" class="card">
      <div class="card-badge">№{{this.id}}</div>
      <h3 class="card-title">{{this.title}}</h3>
      <div class="card-stats">
        <div class="stat">
          <span class="stat-value">{{this.ownershipShare}}%</span>
          <span class="stat-label">Доля владения</span>
        </div>
        <div class="stat">
          <span class="stat-value">{{this.sharesCount}}</span>
          <span class="stat-label">Акций</span>
        </div>
      </div>
      <span class="card-cta">Подробнее →</span>
    </a>
  {{else}}
    <p class="empty-state">Список пуст</p>
  {{/each}}
</div>